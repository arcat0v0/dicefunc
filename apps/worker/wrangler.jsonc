{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dicefunc-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dicefunc-db",
      "database_id": "REPLACE_ME_D1_ID",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "REPLACE_ME_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORY_LOG_BUCKET",
      "bucket_name": "dicefunc-story-logs"
    },
    {
      "binding": "CONFIG_BUCKET",
      "bucket_name": "dicefunc-config"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "COMMAND_QUEUE",
        "queue": "command-queue"
      },
      {
        "binding": "ARCHIVE_QUEUE",
        "queue": "archive-queue"
      }
    ],
    "consumers": [
      {
        "queue": "command-queue",
        "max_batch_size": 10,
        "max_concurrency": 2,
        "max_retries": 3,
        "dead_letter_queue": "command-dlq"
      },
      {
        "queue": "archive-queue",
        "max_batch_size": 5,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "archive-dlq"
      }
    ]
  },
  "build": {
    "command": "pnpm build"
  }
}
